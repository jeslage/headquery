{
  "name": "@headquery/core",
  "version": "0.0.0",
  "description": "CMS-agnostic fetch transport for headquery adapters: deterministic URLs, auth, errors.",
  "license": "MIT",
  "homepage": "https://github.com/jeslage/headquery#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeslage/headquery.git",
    "directory": "packages/js/core"
  },
  "bugs": {
    "url": "https://github.com/jeslage/headquery/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run && tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
