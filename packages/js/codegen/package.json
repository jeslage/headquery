{
  "name": "@headquery/codegen",
  "version": "0.1.0",
  "description": "Generate TypeScript types for headquery clients from a CMS schema (file or URL).",
  "license": "MIT",
  "homepage": "https://github.com/jeslage/headquery#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeslage/headquery.git",
    "directory": "packages/js/codegen"
  },
  "bugs": {
    "url": "https://github.com/jeslage/headquery/issues"
  },
  "type": "module",
  "bin": {
    "headquery": "./bin/headquery.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run && tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@headquery/schema": "workspace:^"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@headquery/statamic": "workspace:^",
    "citty": "0.2.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
